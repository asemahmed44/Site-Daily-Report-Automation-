    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [{ json: { hasReports: false, report: 'لا يوجد تقارير اليوم' } }];\n}\n\nconst today = new Date().toLocaleDateString('ar-EG', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n});\n\nlet html = `\n<div dir=\"rtl\" style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;\">\n<h2 style=\"background-color: #2c3e50; color: white; padding: 15px; border-radius: 8px;\">📊 التقرير اليومي - ${today}</h2>\n<p style=\"color: #666;\">عدد التقارير المستلمة: <strong>${items.length}</strong></p>\n<hr/>\n`;\n\nlet totalHours = 0;\nlet hasProblems = [];\n\nfor (const item of items) {\n  const r = item.json;\n  const hours = parseFloat(r.hours) || 0;\n  totalHours += hours;\n  \n  const problemColor = (r.problem && r.problem !== 'لا يوجد') ? '#e74c3c' : '#27ae60';\n  const problemIcon = (r.problem && r.problem !== 'لا يوجد') ? '⚠️' : '✅';\n  \n  if (r.problem && r.problem !== 'لا يوجد') {\n    hasProblems.push({ engineer: r.engineer_name, project: r.project_name, problem: r.problem });\n  }\n\n  html += `\n  <div style=\"border: 1px solid #ddd; border-radius: 8px; padding: 15px; margin-bottom: 15px; background: #f9f9f9;\">\n    <h3 style=\"color: #2c3e50; margin-top: 0;\">🏗️ ${r.project_name}</h3>\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr><td style=\"padding: 5px; color: #666; width: 140px;\">👷 المهندس:</td><td style=\"padding: 5px;\"><strong>${r.engineer_name}</strong></td></tr>\n      <tr><td style=\"padding: 5px; color: #666;\">✅ الإنجاز:</td><td style=\"padding: 5px;\">${r.achievement}</td></tr>\n      <tr><td style=\"padding: 5px; color: #666;\">${problemIcon} المشكلة:</td><td style=\"padding: 5px; color: ${problemColor};\">${r.problem || 'لا يوجد'}</td></tr>\n      <tr><td style=\"padding: 5px; color: #666;\">⏱️ الساعات:</td><td style=\"padding: 5px;\">${r.hours} ساعة</td></tr>\n      <tr><td style=\"padding: 5px; color: #666;\">📌 مطلوب:</td><td style=\"padding: 5px;\">${r.followup || 'لا يوجد'}</td></tr>\n    </table>\n  </div>`;\n}\n\n// Summary\nhtml += `\n<div style=\"background: #2c3e50; color: white; padding: 15px; border-radius: 8px; margin-top: 20px;\">\n  <h3 style=\"margin-top: 0;\">📌 ملخص اليوم</h3>\n  <p>⏱️ إجمالي الساعات: <strong>${totalHours} ساعة</strong></p>\n  <p>📋 عدد التقارير: <strong>${items.length} تقرير</strong></p>\n  <p>⚠️ مشاكل تحتاج متابعة: <strong>${hasProblems.length}</strong></p>\n`;\n\nif (hasProblems.length > 0) {\n  html += `<ul>`;\n  for (const p of hasProblems) {\n    html += `<li>${p.engineer} - ${p.project}: ${p.problem}</li>`;\n  }\n  html += `</ul>`;\n}\n\nhtml += `</div></div>`;\n\nreturn [{ json: { hasReports: true, report: html, count: items.length, totalHours } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
